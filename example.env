# ==========================================================================
# Lab Order System — example environment file
# --------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values before running
# `npm start`. The `src/config.js` module validates every REQUIRED value at
# boot and the process will exit non-zero if any are missing or malformed.
#
# For local development, generate a JWT at
#   https://jwt.io  (payload: { "sub": "dev-1", "role": "patient",
#                                "customer_id": "cust-dev", "iss": JWT_ISSUER,
#                                "aud": JWT_AUDIENCE, "exp": <timestamp> })
# and set the HS256 secret to the value of JWT_SECRET below.
# ==========================================================================

# ---- Runtime --------------------------------------------------------------
NODE_ENV=development
PORT=8080
# Application log level. Set to `warn` or `error` to quiet request logs.
LOG_LEVEL=info

# ---- GCP ------------------------------------------------------------------
# The Firestore + Pub/Sub project id. Must match the project whose service
# account is mounted into the runtime via GOOGLE_APPLICATION_CREDENTIALS.
GCP_PROJECT=lab-order-systemdata

# KMS resource name used by the PHI envelope encryption module (P3).
# Format: projects/<p>/locations/<loc>/keyRings/<ring>/cryptoKeys/<key>
KMS_KEY_NAME=projects/lab-order-systemdata/locations/global/keyRings/phi/cryptoKeys/phi-field

# ---- Shopify --------------------------------------------------------------
# Shop subdomain (without `.myshopify.com`).
SHOPIFY_SHOP=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# HMAC secret used to verify Shopify webhook signatures.
# Rotate every 90 days.
SHOPIFY_API_WEBHOOK=

# ---- Authentication -------------------------------------------------------
# HS256 signing secret for the JWT middleware. MUST be at least 16 chars.
# In production this should come from Secret Manager, not .env.
JWT_SECRET=change-me-to-a-long-random-string-at-least-16-chars
# Expected `iss` claim. Must be a URL.
JWT_ISSUER=https://auth.example.com/
# Expected `aud` claim.
JWT_AUDIENCE=lab-order-system

# ---- CORS -----------------------------------------------------------------
# Comma-separated list of allowed origins. Empty string disables CORS.
CORS_ALLOWED_ORIGINS=https://app.example.com

# ---- Legacy config values (used by existing route handlers) --------------
# These will be refactored out in P2 when the mass-assignment guard is
# introduced; for now they populate server-owned lab/test-kit fields.
CLINIC_PRACT_ID=
LOC_POS=
ORDER_TAKER=
NAME_OF_REQUESTOR=
REQ_LOC=
STATUS=
